"\n\n{\n  \"schema_version\": \"1.0\",\n  \"document\": {\n    \"title\": \"ECE 150 Project - Square Root Calculator Marmoset Tests\",\n    \"course\": \"ECE 150\",\n    \"assignment_name\": \"Square Root Calculator\",\n    \"page_count\": 4,\n    \"pages_processed\": [1, 2, 3, 4],\n    \"extraction_complete\": true\n  },\n  \"learning_objectives\": [\n    {\n      \"id\": \"LO001\",\n      \"description\": \"Write a C++ program that uses Newton's method to approximate the square root of a number n, given a starting guess s and a maximum error tolerance e; read n >= 0, s > 0, and e > 0 in that order and repeat the relevant prompt until its input is valid.\",\n      \"sources\": [\n        {\"page\": 1, \"section\": \"Learning objectives\", \"evidence\": \"Write a C++ program that uses Newton's method to approximate the square root of a number n, given a starting guess s and a maximum error tolerance e. Read n >= 0, s > 0, and e > 0 in that order; repeat the relevant prompt until its input is valid.\"}\n      ]\n    },\n    {\n      \"id\": \"LO002\",\n      \"description\": \"Practise input validation, floating-point arithmetic, loops, and convergence criteria.\",\n      \"sources\": [\n        {\"page\": 1, \"section\": \"Learning objectives\", \"evidence\": \"This project practises input validation, floating-point arithmetic, loops, and convergence criteria.\"}\n      ]\n    }\n  ],\n  \"requirements\": [\n    {\"id\": \"REQ001\", \"category\": \"algorithm\", \"description\": \"For n > 0, repeatedly calculate the Newton update.\", \"expression\": \"x_{k+1} = 1/2 * (x_k + n / x_k)\", \"literal_strings\": [], \"visibility\": \"student_visible\", \"sources\": [{\"page\": 1, \"section\": \"Learning objectives\", \"evidence\": \"For n > 0, set x_0 = s and repeatedly calculate x_{k+1} = 1/2 (x_k + n/x_k).\"}]},\n    {\"id\": \"REQ002\", \"category\": \"algorithm\", \"description\": \"Initialize the estimate from the supplied starting guess for n > 0.\", \"expression\": \"x_0 = s\", \"literal_strings\": [], \"visibility\": \"student_visible\", \"sources\": [{\"page\": 1, \"section\": \"Learning objectives\", \"evidence\": \"For n > 0, set x_0 = s\"}]},\n    {\"id\": \"REQ003\", \"category\": \"algorithm\", \"description\": \"Stop at the first update satisfying the absolute tolerance on the change between successive estimates; equality is included in the stopping condition.\", \"expression\": \"|x_{k+1} - x_k| <= e\", \"literal_strings\": [], \"visibility\": \"student_visible\", \"sources\": [{\"page\": 1, \"section\": \"Learning objectives\", \"evidence\": \"Stop at the first update satisfying |x_{k+1} - x_k| <= e\"}, {\"page\": 3, \"section\": \"Notes and known issues\", \"evidence\": \"e is an absolute tolerance on the change between successive estimates: |x_{k+1} - x_k| <= e.\"}, {\"page\": 3, \"section\": \"Notes and known issues\", \"evidence\": \"Include equality in the stopping condition: (n, s, e) = (2, 1, 0.5) must stop after one update.\"}]},\n    {\"id\": \"REQ004\", \"category\": \"algorithm\", \"description\": \"Output the new estimate x_{k+1}, including when the first update meets the condition.\", \"expression\": null, \"literal_strings\": [], \"visibility\": \"student_visible\", \"sources\": [{\"page\": 1, \"section\": \"Learning objectives\", \"evidence\": \"and output x_{k+1}\"}, {\"page\": 3, \"section\": \"Notes and known issues\", \"evidence\": \"Always output the new estimate, including when the first update meets the condition.\"}]},\n    {\"id\": \"REQ005\", \"category\": \"algorithm\", \"description\": \"For n = 0, read and validate all three inputs, then output zero directly without division by zero.\", \"expression\": null, \"literal_strings\": [], \"visibility\": \"student_visible\", \"sources\": [{\"page\": 1, \"section\": \"Learning objectives\", \"evidence\": \"For n = 0, read and validate all three inputs, then output zero directly.\"}, {\"page\": 2, \"section\": \"Release tests /13\", \"evidence\": 