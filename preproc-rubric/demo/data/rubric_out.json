\": \"output\", \"description\": \"Use the three prompts, one line per prompt, each ending with std::endl.\", \"expression\": null, \"literal_strings\": [\"Enter a non-negative number:\", \"Enter a positive starting guess:\", \"Enter a positive error tolerance:\"], \"visibility\": \"student_visible\", \"sources\": [{\"page\": 3, \"section\": \"Notes and known issues\", \"evidence\": \"Use the prompts below, one line per prompt, ending with std::endl.\"}]},\n    {\"id\": \"REQ017\", \"category\": \"input\", \"description\": \"Read one value after each prompt.\", \"expression\": null, \"literal_strings\": [], \"visibility\": \"student_visible\", \"sources\": [{\"page\": 3, \"section\": \"Notes and known issues\", \"evidence\": \"Read one value after each prompt.\"}]},\n    {\"id\": \"REQ018\", \"category\": \"output\", \"description\": \"Print one result line using the label 'Square root:' and std::setprecision(17).\", \"expression\": null, \"literal_strings\": [\"Square root:\"], \"visibility\": \"student_visible\", \"sources\": [{\"page\": 3, \"section\": \"Notes and known issues\", \"evidence\": \"Print one result line using the label Square root: and std::setprecision(17).\"}]},\n    {\"id\": \"REQ019\", \"category\": \"output\", \"description\": \"Equivalent decimal or scientific notation is acceptable for the result.\", \"expression\": null, \"literal_strings\": [], \"visibility\": \"student_visible\", \"sources\": [{\"page\": 3, \"section\": \"Notes and known issues\", \"evidence\": \"Equivalent decimal or scientific notation is acceptable.\"}]},\n    {\"id\": \"REQ020\", \"category\": \"output\", \"description\": \"Do not add iteration logs, extra numbers, or blank lines.\", \"expression\": null, \"literal_strings\": [], \"visibility\": \"student_visible\", \"sources\": [{\"page\": 3, \"section\": \"Notes and known issues\", \"evidence\": \"Do not add iteration logs, extra numbers, or blank lines.\"}]},\n    {\"id\": \"REQ021\", \"category\": \"output\", \"des